<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="./exoplayer" />
        <exclude
            domain="file"
            path="./download" />
        <exclude
            domain="database"
            path="exoplayer_internal.db" />
        <exclude domain="sharedpref" path="tokens.xml" />
        <exclude domain="sharedpref" path="amazon_session.xml" />
        <exclude domain="sharedpref" path="ytm_session.xml" />
        <exclude domain="sharedpref" path="apple_session.xml" />
        <exclude domain="sharedpref" path="spotify_session.xml" />
        <exclude domain="sharedpref" path="deezer_session.xml" />
        <exclude domain="sharedpref" path="soundcloud_session.xml" />
        <exclude domain="sharedpref" path="liveone_session.xml" />
        <exclude domain="sharedpref" path="anghami_session.xml" />
        <exclude domain="sharedpref" path="qobuz_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="./exoplayer" />
        <exclude
            domain="file"
            path="./download" />
        <exclude
            domain="database"
            path="exoplayer_internal.db" />
        <exclude domain="sharedpref" path="tokens.xml" />
        <exclude domain="sharedpref" path="amazon_session.xml" />
        <exclude domain="sharedpref" path="ytm_session.xml" />
        <exclude domain="sharedpref" path="apple_session.xml" />
        <exclude domain="sharedpref" path="spotify_session.xml" />
        <exclude domain="sharedpref" path="deezer_session.xml" />
        <exclude domain="sharedpref" path="soundcloud_session.xml" />
        <exclude domain="sharedpref" path="liveone_session.xml" />
        <exclude domain="sharedpref" path="anghami_session.xml" />
        <exclude domain="sharedpref" path="qobuz_session.xml" />
    </device-transfer>
</data-extraction-rules>